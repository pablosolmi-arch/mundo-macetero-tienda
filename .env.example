DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
SITE_URL=
# Shared secret for the daily crons: the Supabase keep-alive
# (/api/cron/keepalive) and the abandoned-cart reminder (/api/cron/carritos).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Pasarela de pago. Mercado Pago es la principal (Mercado Pago -> Tus
# integraciones -> Credenciales de producción). Si no está, se usa Transbank
# (Webpay Plus) y después Flow. Sin ninguna, el checkout responde 503 con mensaje
# claro.
MP_ACCESS_TOKEN=
# Transbank Webpay Plus REST: código de comercio y llave secreta del portal.
# TBK_BASE_URL solo para apuntar al ambiente de integración
# (https://webpay3gint.transbank.cl); por defecto es producción.
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_BASE_URL=
# Correos transaccionales (Resend). Sin la clave, la tienda funciona igual pero
# no envía confirmaciones ni avisos; el panel deja constancia en cada pedido.
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Mundo Macetero <pedidos@mundomacetero.cl>"
MAIL_FROM=
# Quién recibe el aviso de cada venta (por defecto, el correo de la tienda)
MAIL_EQUIPO=
